            "job_cd": {
              "type": "string"
            },
            "job_lrcl_nm": {
              "type": "string"
            },
            "job_mdcl_nm": {
              "type": "string"
            },
            "job_smcl_nm": {
              "type": "string"
            },
            "source_ref": {
              "type": "object",
              "additionalProperties": false,
