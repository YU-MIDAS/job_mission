              "additionalProperties": false,
              "required": [
                "level",
                "label",
                "estimated_time_minutes",
                "material_bundle_style",
                "material_count_range",
                "task_count_range",
                "answer_length_hint",
                "requires_cross_material_reasoning",
                "requires_tradeoff_judgment",
                "requires_domain_expertise"
