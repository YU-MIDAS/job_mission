              "required": [
                "role",
                "context",
                "goal",
                "constraints"
              ],
              "properties": {
                "role": {
                  "type": "string"
                },
                "context": {
                  "type": "string"
                },
                "goal": {
                  "type": "string"
                },
                "constraints": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            },
            "materials": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "material_id",
