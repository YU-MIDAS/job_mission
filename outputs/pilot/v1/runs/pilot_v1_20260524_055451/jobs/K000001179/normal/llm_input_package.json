                              "properties": {
                                "strength": {
                                  "type": "string"
                                },
                                "weakness": {
                                  "type": "string"
                                },
                                "fit": {
                                  "type": "string"
                                }
                              }
                            }
                          }
                        }
                      }
                    }
                  },
                  "confidence": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "score",
                      "checks",
                      "warnings"
                    ],
                    "properties": {
                      "score": {
                        "type": "number"
                      },
                      "checks": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "synthetic_material"
