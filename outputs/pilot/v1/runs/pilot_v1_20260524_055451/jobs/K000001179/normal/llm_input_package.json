      "allowed_material_types": [
        "card",
        "chart",
        "checklist",
        "email",
        "log",
        "memo",
        "schedule",
        "table"
      ],
      "allowed_evidence_names": [
        "수리력",
        "판단과 의사결정",
        "선택적 집중력",
        "논리적 분석",
        "공간지각력",
        "경제와 회계",
        "영어",
        "사무",
        "경영 및 행정",
        "산수와 수학",
        "치열한 경쟁",
        "마감시간",
        "이메일 이용하기",
        "앉아서 근무",
        "연설, 발표, 회의하기",
        "정보 수집",
        "목표, 전략 수립",
        "사물, 행동, 사건 파악",
        "정보의 의미 해석",
        "사람들에게 조언, 상담",
        "의사 결정, 문제점 해결",
        "정보, 자료 분석",
        "절차, 자료, 주변환경 관찰",
        "정보 처리",
        "대인관계 유지"
      ],
      "use_only_allowed_material_types": true,
      "excluded_material_types": [
        "image",
        "screenshot"
      ],
      "factual_status_required": true,
      "mission_fact_refs_required": true,
      "evidence_source_required": true,
      "factual_status_value": "synthetic_mission_material"
    },
    "mission_fact_rules": {
      "must_create_before_materials": true,
      "all_material_refs_must_exist": true,
      "no_cross_material_conflict": true
    },
    "repair_policy": {
      "max_repair_attempts": 1,
      "repair_only_validator_errors": true,
      "do_not_change_system_decisions": true
    },
    "structured_output_schema": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "mission_id",
        "job_identity",
        "target_exec_job",
        "mission_facts",
        "mission",
        "evaluation",
        "evidence_chain_draft",
        "reliability"
      ],
      "properties": {
        "schema_version": {
          "enum": [
            "mission_output.v1"
          ]
        },
        "mission_id": {
          "enum": [
            "draft"
          ]
        },
        "job_identity": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "job_cd",
            "job_lrcl_nm",
            "job_mdcl_nm",
            "job_smcl_nm",
            "source_ref"
