                        "정보, 자료 분석",
                        "절차, 자료, 주변환경 관찰",
                        "정보 처리",
                        "대인관계 유지"
                      ]
                    }
                  },
                  "mission_fact_refs": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
