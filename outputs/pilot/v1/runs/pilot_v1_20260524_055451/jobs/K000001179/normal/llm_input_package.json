          "properties": {
            "expected_insights": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "rubric": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "criterion",
                  "description",
                  "points",
                  "linked_evidence"
                ],
                "properties": {
                  "criterion": {
                    "type": "string"
                  },
                  "description": {
                    "type": "string"
                  },
                  "points": {
                    "type": "integer"
                  },
                  "linked_evidence": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        },
        "evidence_chain_draft": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "source_exec_job",
            "linked_evidence",
            "material_evidence_map"
          ],
          "properties": {
            "source_exec_job": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "text"
              ],
              "properties": {
                "id": {
                  "type": "string"
                },
                "text": {
                  "type": "string"
                }
              }
            },
            "linked_evidence": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "activities",
                "knowledge",
                "abilities"
              ],
              "properties": {
                "activities": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "knowledge": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "abilities": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            },
            "material_evidence_map": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "material_id",
                  "supported_by"
                ],
                "properties": {
                  "material_id": {
                    "type": "string"
                  },
                  "supported_by": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        },
        "reliability": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status"
          ],
          "properties": {
            "status": {
              "enum": [
                "pending_validation"
              ]
            }
          }
        }
      }
    }
  }
}
