                        "properties": {
                          "synthetic_material": {
                            "type": "boolean"
                          }
                        }
                      },
                      "warnings": {
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      }
                    }
                  }
                }
              }
            },
            "tasks": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "task_id",
                  "instruction",
                  "required_materials",
                  "expected_action"
                ],
                "properties": {
                  "task_id": {
                    "type": "string"
                  },
                  "instruction": {
                    "type": "string"
                  },
                  "required_materials": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "expected_action": {
                    "type": "string"
                  }
                }
              }
            },
            "submission_format": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "type",
                "estimated_time_minutes",
                "required_sections",
                "length_hint"
              ],
              "properties": {
                "type": {
                  "type": "string"
                },
                "estimated_time_minutes": {
                  "type": "integer"
                },
                "required_sections": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "length_hint": {
                  "type": "string"
                }
              }
            }
          }
