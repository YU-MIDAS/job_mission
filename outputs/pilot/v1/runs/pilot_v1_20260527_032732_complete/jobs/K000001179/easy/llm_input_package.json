    "work": {
      "job_summary": {
        "text": "국내외 금융시장 정보를 수집·분석·예측하여 소속 금융사 또는 일반 투자자에게 투자자문을 제공한다.",
        "source_ref": {
          "file": "K000001179/dtlGb_2.xml",
