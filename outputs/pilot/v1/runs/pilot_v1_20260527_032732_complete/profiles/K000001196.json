  "work": {
    "job_summary": {
      "text": "사원의 채용·배치·전환·퇴직·급여·인사고과·담당섭외 업무를 기획·건의·집행하는 인사노무 사무를 수행한다.",
      "source_ref": {
        "file": "K000001196/dtlGb_2.xml",
        "field": "jobsDo.jobSum"
      }
    },
    "exec_jobs": [
      {
        "exec_job_id": "exec_001",
        "text": "현재 및 미래에 있을 결원을 파악하고 부서별 충원요청 시 기존의 정원과 대비·검토하고 인력수급계획을 수립한다.",
        "source_ref": {
          "file": "K000001196/dtlGb_2.xml",
          "field": "jobsDo.execJob",
          "index": 1
        }
      },
      {
        "exec_job_id": "exec_002",
        "text": "광고나 사내공고, 학교추천의뢰 등을 통하여 원서를 접수하고 서류심사 및 소정의 전형을 진행·주관한다.",
        "source_ref": {
          "file": "K000001196/dtlGb_2.xml",
          "field": "jobsDo.execJob",
          "index": 2
        }
      },
      {
        "exec_job_id": "exec_003",
        "text": "지원자들에게 채용 요건에 관해 설명해 주고, 합격자에게는 소정의 서류를 구비토록 하여 배치계획에 따라 인사발령을 품의한다.",
        "source_ref": {
          "file": "K000001196/dtlGb_2.xml",
          "field": "jobsDo.execJob",
          "index": 3
        }
      },
      {
        "exec_job_id": "exec_004",
        "text": "경영목표 달성을 위한 인건비예산의 수립지침서를 입안하고 인건비예산을 총괄하며 취합된 인건비예산안을 경영목표, 과거실적, 예정임금인상율 등을 감안하여 분석·보고한다.",
        "source_ref": {
          "file": "K000001196/dtlGb_2.xml",
          "field": "jobsDo.execJob",
          "index": 4
        }
      },
      {
        "exec_job_id": "exec_005",
        "text": "매월, 분기, 반기, 년간 인원현황과 인건비 지급실적을 예산과 대비하여 분석, 보고한다.",
        "source_ref": {
          "file": "K000001196/dtlGb_2.xml",
          "field": "jobsDo.execJob",
          "index": 5
        }
      },
      {
        "exec_job_id": "exec_006",
        "text": "인사제도, 인사고과의 활용, 복리후생, 안전보건, 인간관계, 사원의 사기 등을 파악하여 타사 및 관계문헌을 조사·비교·분석하여 개선안을 기획·품의한다.",
        "source_ref": {
          "file": "K000001196/dtlGb_2.xml",
          "field": "jobsDo.execJob",
          "index": 6
        }
      },
      {
        "exec_job_id": "exec_007",
        "text": "직원의 채용, 전보, 휴직, 복직 및 면직, 승진, 표창 및 징계에 관한 업무를 수행하고 직원의 종합인사평점과 인사기록을 확인하고 관리한다.",
        "source_ref": {
          "file": "K000001196/dtlGb_2.xml",
          "field": "jobsDo.execJob",
          "index": 7
        }
      }
    ]
  },
  "technical_context": {
    "techn_know": {
      "text": "인사 및 노무사무원으로 일하는 데 필요한 학력은 근무하는 곳에 따라 차이가 있다. 일반적으로 소규모 업체나 중소기업은 고등학교 졸업 이상의 학력을 요구하며 대기업의 경우 법학, 경제학, 경영학, 무역학, 회계학 등 관련 분야 대졸 이상의 학력을 요구한다. 인사 및 노무사무원이 갖춰야 할 특별한 자격증은 없으나 인터넷 활용능력과 컴퓨터를 활용한 문서작성 능력은 필수로 갖추어야 한다. 또한, 취업한 뒤 일정 기간의 교육훈련과 현장견습이 필요하다.",
      "source_ref": {
        "file": "K000001196/dtlGb_3.xml",
        "field": "way.technKnow"
      }
    }
  },
