# Always exclude local/debug/test output, even under output folders.
outputs/_test_tmp/
outputs/**/_test_tmp/
outputs/**/debug/
outputs/**/tmp/
outputs/**/temp/

# Safety: never commit raw prompts, raw API dumps, auth headers, or secrets.
outputs/**/raw_request*
outputs/**/raw_response*
outputs/**/raw_prompt*
outputs/**/raw_completion*
outputs/**/prompt_dump*
outputs/**/response_dump*
outputs/**/authorization*
outputs/**/secret*

# Python bytecode / runtime caches
__pycache__/
*.py[cod]
*$py.class
.python-version
.cache/
.ipynb_checkpoints/

# Python virtual environments
.venv/
venv/
env/
ENV/

