# Environment variables / secrets
.env
.env.*
!.env.example
!.env.*.example
*.key
*.pem
*.p12
*.pfx
*.crt
*.cer
*.der
.secrets/
secrets/
credentials*.json
service-account*.json

# Large local source datasets
data/

# Keep curated practice sheet markdown, but never raw survey/source files.
!data/
data/*
!data/additional_search/
data/additional_search/*
!data/additional_search/*.md
data/additional_search/raw/

# Internal working documents
docx/

# Generated outputs
output/
outputs/*

# Keep generated UI exports and matching source artifacts for published UI runs.
!outputs/ui/
outputs/ui/*
!outputs/ui/v1/
outputs/ui/v1/*
!outputs/ui/v1/runs/
outputs/ui/v1/runs/*
!outputs/ui/v1/runs/**/
!outputs/ui/v1/runs/**/mission_ui.html
!outputs/ui/v1/runs/**/mission_learner.html

!outputs/profiles/
outputs/profiles/*
!outputs/profiles/v1/
outputs/profiles/v1/*
!outputs/profiles/v1/*.json

!outputs/pilot/
outputs/pilot/*
!outputs/pilot/v1/
outputs/pilot/v1/*
!outputs/pilot/v1/runs/
outputs/pilot/v1/runs/*
